{
  "name": "scum-robot-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "deploy": "npm run build:prod && echo 构建完成，文件已输出到后端public文件夹",
    "deploy:dev": "npm run build:dev && echo 开发构建完成",
    "clean": "rimraf \"../SCUM Robot/public/assets\" \"../SCUM Robot/public/fonts\" \"../SCUM Robot/public/index.html\" \"../SCUM Robot/public/favicon.svg\" \"../SCUM Robot/public/favicon.ico\" && echo 清理完成",
    "rebuild": "npm run clean && npm run deploy",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.0.1",
    "axios": "^1.12.2",
    "pinia": "^3.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0"
  }
}
