# SCUM Robot 后端环境变量模板
# 复制为 .env 后按需修改。首次建库前请务必设置管理员初始密码。

# 数据库
DATABASE_URL=sqlite:///bakend/modules/sql/scum_robot.db

# JWT
JWT_SECRET_KEY=replace-with-a-strong-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 支付回调域名
# 本地开发默认值可使用 http://localhost:8000
# 生产环境必须改为外网可访问的完整域名，例如 https://api.example.com
PAYMENT_CALLBACK_DOMAIN=http://localhost:8000

# 启动日志
LOG_LEVEL=INFO
DEBUG=false

# 首次初始化超级管理员
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
